# PayPal credentials — https://developer.paypal.com/dashboard/applications/sandbox
# Copy to .env.local (git-ignored) and fill in.

# "sandbox" (fake money) or "production" (real money). Must match the credentials below.
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=sandbox

# Client ID is public — safe in the browser.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Secret is server-only. NEVER prefix with NEXT_PUBLIC_.
PAYPAL_CLIENT_SECRET=

# Optional: Webhook ID from Dashboard → your app → Webhooks (for /api/paypal/webhook)
PAYPAL_WEBHOOK_ID=

# Optional: log full PayPal request/response bodies
# PAYPAL_DEBUG=1

# --- Email (optional) -------------------------------------------------------
# Any SMTP provider, e.g. smtps://you%40gmail.com:app-password@smtp.gmail.com:465
#                         smtp://resend:re_xxx@smtp.resend.com:587
# Without it, buyer emails are only logged to the Outbox.
SMTP_URL=
EMAIL_FROM="Recall Desk <recalls@yourdomain.com>"
# Demo safety: send ALL buyer email to this one inbox instead of the buyers.
EMAIL_REDIRECT_TO=
# Public base URL for links in emails (defaults to the request's host).
APP_URL=
